    {"id":"alarm_tab","type":"tab","label":"rpo-alarm Example","disabled":false,"info":""},
    {"id":"alarm_c","type":"comment","z":"alarm_tab","name":"=== rpo-alarm: alarm with acknowledgement ===","info":"1. \"Fault ON\": alarm becomes active (output 1 = true).\n2. \"Fault OFF\": alarm stays active, it is not acknowledged yet (latched).\n3. \"Acknowledge\": alarm goes back to normal (output 1 = false).\nAcknowledging while the fault is still present keeps the alarm active until the fault is gone.\n\"Inhibit\" suppresses the alarm, e.g. while the plant is off.\nOutput 2 sends the alarm object on every state change (for notifications, dashboards, logging).","x":260,"y":40,"wires":[]},
    {"id":"alarm_i1","type":"inject","z":"alarm_tab","name":"Fault ON","props":[{"p":"payload","v":"true","vt":"bool"},{"p":"topic","v":"alarm","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"alarm","payload":"true","payloadType":"bool","x":150,"y":100,"wires":[["alarm_n"]]},
