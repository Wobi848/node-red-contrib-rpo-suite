    {"id":"alarm_i4","type":"inject","z":"alarm_tab","name":"Inhibit ON","props":[{"p":"payload","v":"true","vt":"bool"},{"p":"topic","v":"inhibit","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"inhibit","payload":"true","payloadType":"bool","x":150,"y":220,"wires":[["alarm_n"]]},
